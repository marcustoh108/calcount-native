# Copy this file to .env.local (never commit .env.local) and fill in your Supabase project's values.
# Both are safe to ship inside the app: the anon/publishable key only allows what the server allows.
# NEVER put the service_role / secret key or your Anthropic API key here — EXPO_PUBLIC_ values are
# bundled into the app and anyone can read them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
