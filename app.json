{
  "expo": {
    "name": "CalCount",
    "slug": "calcount-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "calcount",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calcount.native",
      "infoPlist": {
        "NSCameraUsageDescription": "CalCount uses your camera to identify food and estimate calories, nutrients, and health safety.",
        "NSPhotoLibraryUsageDescription": "CalCount lets you analyze food photos from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.calcount.native",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CalCount uses your camera to identify food and estimate calories, nutrients, and health safety."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CalCount lets you analyze food photos from your library."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1420",
          "image": "./assets/icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
